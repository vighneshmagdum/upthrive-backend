# Local development values only. Replace all secrets before exposing this app publicly.
POSTGRES_DB=upthrive
POSTGRES_USER=upthrive
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql+psycopg://upthrive:local-only-change-me@localhost:5432/upthrive
JWT_SECRET=local-development-only-change-this-secret-before-deployment-123456
ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost
APP_DOMAIN=:80
